(embed :: SF a b -> \(a, [\(DTime, Maybe a\)]\) -> [b]) s
5 398 M
(embed sf0 \(a0, dtas\) = b0 : loop a0 sf dtas) s
5 390 M
(    where) s
5 382 M
(        \(sf, b0\) = \(sfTF sf0\) a0) s
5 366 M
