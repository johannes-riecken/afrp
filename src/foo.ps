5 254 M
(deltaEncodeBy _  _  []        = afrpErr "deltaEncodeBy" "Empty input list.") s
5 246 M
(deltaEncodeBy eq dt \(a0 : as\) = \(a0, zip \(repeat dt\) \(debAux a0 as\)\)) s
5 238 M
(    where) s
5 230 M
(        debAux a_prev []                     = []) s
5 222 M
(        debAux a_prev \(a:as\) | a `eq` a_prev = Nothing : debAux a as) s
5 214 M
(                             | otherwise     = Just a  : debAux a as ) s
