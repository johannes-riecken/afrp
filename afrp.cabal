cabal-version:      >=1.10
name:               afrp
version:            0.4
license:            BSD-3-Clause
license-file:       LICENSE.txt
author:             Henrik Nilsson, Antony Courtney
maintainer:         placeholder@example.com
category:           FRP
build-type:         Simple
extra-source-files: README.md

library
  exposed-modules:
    AFRP
    AFRPAffineSpace
    AFRPDiagnostics
    AFRPEvent
    AFRPForceable
    AFRPGeometry
    AFRPInternals
    AFRPMergeableRecord
    AFRPMiscellany
    AFRPPoint2
    AFRPPoint3
    AFRPTask
    AFRPUtilities
    AFRPVector2
    AFRPVector3
    AFRPVectorSpace
  build-depends:
    base >=4 && <5,
    array,
    containers,
    random
  hs-source-dirs:   src
  default-language: Haskell2010

executable space-invaders
  main-is:          Main.hs
  other-modules:
    SimpleGun
    ObjectBehavior
    Animate
    ColorBindings
    Colors
    Command
    Diagnostics
    IdentityList
    Object
    Parser
    PhysicalDimensions
    RenderLandscape
    RenderObject
    WorldGeometry
  hs-source-dirs:   examples/SpaceInvaders/src
  build-depends:
    base >=4 && <5,
    afrp
  default-language: Haskell2010

executable tailgating-detector
  main-is:          TestTGMain.hs
  other-modules:
    TailgatingDetector
  hs-source-dirs:   examples/TailgatingDetector
  build-depends:
    base >=4 && <5,
    afrp
  default-language: Haskell2010
